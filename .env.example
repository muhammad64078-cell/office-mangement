# Supabase frontend env vars (already populated in the hosted environment)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge function secret — set this as a Supabase Edge Function secret named
# PUNCH_API_KEY. The bridge script must send the same value in the
# X-Punch-Key header. Generate a long random string.
# This is NOT a VITE_ var (must not be exposed to the browser).
