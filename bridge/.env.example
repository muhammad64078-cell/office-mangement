# Supabase project URL (same as the frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Secret API key shared with the `punch` edge function. Must match the
# PUNCH_API_KEY secret set on the Supabase project.
PUNCH_API_KEY=change-me-to-a-long-random-string

# ZKTeco device network settings
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370

# Optional label stored on each raw event for identification
DEVICE_ID=zk-door-1
